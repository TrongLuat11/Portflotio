{# 
  Layout chính (base.njk) — Giống @extends('layouts.app') trong Laravel Blade
  Tất cả các trang sẽ kế thừa layout này.
  Bao gồm: meta tags, Tailwind CSS CDN, Chart.js CDN, Google Fonts,
  header, footer, và các script.
#}
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  {# === SEO Meta Tags === #}
  <title>{{ site.title }} | {{ site.name }}</title>
  <meta name="description" content="{{ site.tagline }}">
  <meta name="author" content="{{ site.name }}">
  <meta name="keywords" content="data intern, IT intern, portfolio, python, sql, machine learning, NLP, MIS, phân tích dữ liệu">
  
  {# === Open Graph cho chia sẻ mạng xã hội === #}
  <meta property="og:title" content="{{ site.title }} | {{ site.name }}">
  <meta property="og:description" content="{{ site.tagline }}">
  <meta property="og:type" content="website">
  
  {# === Google Fonts: Inter (sans-serif) + JetBrains Mono (monospace) === #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  {# === Tailwind CSS qua CDN === #}
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    // Cấu hình Tailwind: thêm font tùy chỉnh và màu nhấn
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            navy: {
              50:  '#eef2f7',
              100: '#d4dce8',
              200: '#a9b9d1',
              300: '#7e96ba',
              400: '#5373a3',
              500: '#3b5998',
              600: '#2d4a80',
              700: '#1e3a5f',
              800: '#152b47',
              900: '#0b1b2f',
              950: '#060f1a',
            },
            accent: {
              DEFAULT: '#2563eb',
              light: '#60a5fa',
              dark: '#1d4ed8',
            }
          }
        }
      }
    }
  </script>
  
  {# === Chart.js CDN cho biểu đồ kỹ năng === #}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  
  {# === Lucide Icons CDN === #}
  <script src="https://unpkg.com/lucide@latest"></script>
  
  {# === CSS tùy chỉnh === #}
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-white dark:bg-navy-950 text-gray-800 dark:text-gray-200 font-sans transition-colors duration-300">
  
  {# === Header / Navigation — Giống @include('components.nav') === #}
  {% include "components/nav.njk" %}
  
  {# === Nội dung chính — Giống @yield('content') trong Blade === #}
  <main>
    {{ content | safe }}
  </main>
  
  {# === Footer === #}
  {% include "components/footer.njk" %}
  
  {# === JavaScript === #}
  <script src="/js/script.js"></script>
  
  {# === Khởi tạo Lucide Icons === #}
  <script>
    lucide.createIcons();
  </script>
</body>
</html>
