{# 
  Component Timeline (Experience & Education)
  Hiển thị kinh nghiệm và học vấn dạng timeline dọc
  Dữ liệu đọc từ site.json
#}
<section id="timeline" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {# === Tiêu đề Section === #}
    <div class="text-center mb-16 fade-in">
      <p class="text-accent dark:text-accent-light font-mono text-sm tracking-wider uppercase mb-2">Hành trình</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        Kinh nghiệm & Học vấn
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-accent to-navy-500 mx-auto mt-4 rounded-full"></div>
    </div>
    
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16">
      
      {# === Cột trái: Kinh nghiệm === #}
      <div class="fade-in">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-8 flex items-center gap-2">
          <span class="text-2xl">💼</span> Kinh nghiệm
        </h3>
        
        <div class="relative">
          {# Đường kẻ dọc timeline #}
          <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-accent via-navy-400 to-transparent"></div>
          
          {# Loop qua kinh nghiệm #}
          {% for item in site.experience %}
            <div class="relative pl-12 pb-10 last:pb-0 fade-in" style="animation-delay: {{ loop.index0 * 200 }}ms;">
              {# Chấm tròn trên timeline #}
              <div class="absolute left-2.5 top-1 w-3.5 h-3.5 bg-accent rounded-full border-2 border-white dark:border-navy-950 shadow-lg shadow-accent/30 z-10"></div>
              
              {# Card nội dung #}
              <div class="bg-white dark:bg-navy-800/50 rounded-xl p-5 border border-gray-100 dark:border-navy-700/50 hover:shadow-md hover:border-accent/20 transition-all duration-300">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div>
                    <h4 class="font-semibold text-gray-900 dark:text-white">{{ item.title }}</h4>
                    <p class="text-accent dark:text-accent-light text-sm font-medium">{{ item.company }}</p>
                  </div>
                  <span class="text-xs font-mono text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-navy-700 px-2 py-1 rounded-md whitespace-nowrap">
                    {{ item.period }}
                  </span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{{ item.description }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      
      {# === Cột phải: Học vấn === #}
      <div class="fade-in">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-8 flex items-center gap-2">
          <span class="text-2xl">🎓</span> Học vấn & Chứng chỉ
        </h3>
        
        <div class="relative">
          {# Đường kẻ dọc timeline #}
          <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gradient-to-b from-navy-400 via-accent to-transparent"></div>
          
          {# Loop qua học vấn #}
          {% for item in site.education_timeline %}
            <div class="relative pl-12 pb-10 last:pb-0 fade-in" style="animation-delay: {{ loop.index0 * 200 }}ms;">
              {# Chấm tròn trên timeline #}
              <div class="absolute left-2.5 top-1 w-3.5 h-3.5 bg-navy-500 dark:bg-navy-400 rounded-full border-2 border-white dark:border-navy-950 shadow-lg shadow-navy-500/30 z-10"></div>
              
              {# Card nội dung #}
              <div class="bg-white dark:bg-navy-800/50 rounded-xl p-5 border border-gray-100 dark:border-navy-700/50 hover:shadow-md hover:border-navy-300/30 transition-all duration-300">
                <div class="flex items-start justify-between gap-2 mb-2">
                  <div>
                    <h4 class="font-semibold text-gray-900 dark:text-white">{{ item.title }}</h4>
                    <p class="text-navy-500 dark:text-navy-300 text-sm font-medium">{{ item.institution }}</p>
                  </div>
                  <span class="text-xs font-mono text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-navy-700 px-2 py-1 rounded-md whitespace-nowrap">
                    {{ item.period }}
                  </span>
                </div>
                <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">{{ item.description }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
