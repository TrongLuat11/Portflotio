{# 
  Component Skills Section (ĐÃ CẬP NHẬT)
  - Bỏ biểu đồ Chart.js radar
  - Cards kỹ năng full-width grid
  - Click vào card → mở modal hiện dự án liên quan (match theo tags)
#}
<section id="skills" class="py-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {# === Tiêu đề Section === #}
    <div class="text-center mb-16 fade-in">
      <p class="text-accent dark:text-accent-light font-mono text-sm tracking-wider uppercase mb-2">Kỹ năng</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        Công cụ & Kỹ năng
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-accent to-navy-500 mx-auto mt-4 rounded-full"></div>
      <p class="text-gray-600 dark:text-gray-400 mt-4 max-w-lg mx-auto">
        Nhấn vào kỹ năng để xem các dự án liên quan
      </p>
    </div>
    
    {# === Grid kỹ năng — full width === #}
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {% for skill in skills %}
        <div class="fade-in" style="animation-delay: {{ loop.index0 * 80 }}ms;">
          {# Card có thể click — mở modal dự án #}
          <button type="button"
                  class="skill-card w-full text-left bg-white dark:bg-navy-800/50 rounded-xl p-5 border border-gray-100 dark:border-navy-700/50 hover:shadow-lg hover:border-accent/30 dark:hover:border-accent/30 transform hover:-translate-y-1 transition-all duration-300 cursor-pointer group"
                  data-skill-name="{{ skill.name }}"
                  onclick="openSkillModal('{{ skill.name }}')">
            
            {# Icon + tên #}
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl group-hover:scale-110 transition-transform duration-300">{{ skill.icon }}</span>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm group-hover:text-accent dark:group-hover:text-accent-light transition-colors">{{ skill.name }}</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 font-mono">{{ skill.category }}</p>
              </div>
            </div>
            
            {# Mô tả #}
            <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed mb-2">{{ skill.description }}</p>
            
            {# Hint nhấn để xem #}
            <div class="flex items-center gap-1 text-xs text-accent/60 dark:text-accent-light/60 group-hover:text-accent dark:group-hover:text-accent-light transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
              <span>Xem dự án</span>
            </div>
          </button>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{# === MODAL — Hiện dự án liên quan khi click skill === #}
<div id="skill-modal" class="fixed inset-0 z-[100] hidden">
  {# Overlay tối #}
  <div id="skill-modal-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeSkillModal()"></div>
  
  {# Modal content #}
  <div class="absolute inset-4 sm:inset-8 md:inset-12 lg:inset-x-24 lg:inset-y-16 bg-white dark:bg-navy-900 rounded-2xl shadow-2xl overflow-hidden flex flex-col modal-content">
    
    {# Header modal #}
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-navy-700">
      <div class="flex items-center gap-3">
        <span id="modal-skill-icon" class="text-2xl"></span>
        <div>
          <h3 id="modal-skill-name" class="text-xl font-bold text-gray-900 dark:text-white"></h3>
          <p id="modal-skill-desc" class="text-sm text-gray-500 dark:text-gray-400"></p>
        </div>
      </div>
      <button onclick="closeSkillModal()" 
              class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-navy-800 text-gray-500 dark:text-gray-400 transition-colors"
              aria-label="Đóng">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    
    {# Body modal — danh sách dự án #}
    <div id="modal-projects-list" class="flex-1 overflow-y-auto px-6 py-6 space-y-4">
      {# Nội dung được JS render động #}
    </div>
  </div>
</div>

{# === Script xử lý modal === #}
<script>
  // Dữ liệu skills (render từ Nunjucks)
  const skillsData = [
    {% for skill in skills %}
    {
      name: "{{ skill.name }}",
      icon: "{{ skill.icon }}",
      category: "{{ skill.category }}",
      description: "{{ skill.description }}",
      level: {{ skill.level }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ];
  
  // Dữ liệu projects (render từ Nunjucks)
  const projectsData = [
    {% for project in projects %}
    {
      title: "{{ project.title }}",
      summary: "{{ project.summary }}",
      image: "{{ project.image }}",
      tags: [{% for tag in project.tags %}"{{ tag }}"{% if not loop.last %},{% endif %}{% endfor %}],
      github: "{{ project.github }}",
      demo: "{{ project.demo }}",
      problem: "{{ project.problem }}",
      result: "{{ project.result }}"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ];
  
  // Mở modal và hiện dự án match với skill
  function openSkillModal(skillName) {
    const modal = document.getElementById('skill-modal');
    const skill = skillsData.find(s => s.name === skillName);
    if (!skill) return;
    
    // Cập nhật header modal
    document.getElementById('modal-skill-icon').textContent = skill.icon;
    document.getElementById('modal-skill-name').textContent = skill.name;
    document.getElementById('modal-skill-desc').textContent = skill.description;
    
    // Tìm dự án liên quan (match tên skill trong tags — không phân biệt hoa thường)
    const matchedProjects = projectsData.filter(p => 
      p.tags.some(tag => tag.toLowerCase().includes(skillName.toLowerCase()) || 
                         skillName.toLowerCase().includes(tag.toLowerCase()))
    );
    
    // Render danh sách dự án
    const container = document.getElementById('modal-projects-list');
    
    if (matchedProjects.length > 0) {
      container.innerHTML = `
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
          Tìm thấy <span class="font-bold text-accent">${matchedProjects.length}</span> dự án sử dụng ${skillName}
        </p>
        ${matchedProjects.map(project => `
          <div class="bg-gray-50 dark:bg-navy-800/50 rounded-xl overflow-hidden border border-gray-100 dark:border-navy-700/50 hover:shadow-md transition-shadow">
            <div class="flex flex-col sm:flex-row">
              <div class="sm:w-48 h-32 sm:h-auto flex-shrink-0">
                <img src="${project.image}" alt="${project.title}" class="w-full h-full object-cover">
              </div>
              <div class="p-5 flex-1">
                <h4 class="font-bold text-gray-900 dark:text-white mb-2">${project.title}</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">${project.summary}</p>
                <div class="flex flex-wrap gap-1.5 mb-3">
                  ${project.tags.map(tag => `
                    <span class="px-2 py-0.5 text-xs font-mono ${
                      tag.toLowerCase().includes(skillName.toLowerCase()) || skillName.toLowerCase().includes(tag.toLowerCase())
                        ? 'bg-accent/10 text-accent dark:bg-accent/20 dark:text-accent-light border border-accent/20' 
                        : 'bg-gray-100 dark:bg-navy-700 text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-navy-600'
                    } rounded-full">${tag}</span>
                  `).join('')}
                </div>
                <div class="flex gap-3">
                  <a href="${project.github}" target="_blank" 
                     class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-accent transition-colors">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    GitHub
                  </a>
                  ${project.demo !== '#' ? `
                  <a href="${project.demo}" target="_blank"
                     class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-dark transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    Demo
                  </a>` : ''}
                </div>
              </div>
            </div>
          </div>
        `).join('')}
      `;
    } else {
      // Chưa có dự án nào match — hiện placeholder
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center py-16 text-center">
          <div class="w-20 h-20 bg-gray-100 dark:bg-navy-800 rounded-full flex items-center justify-center mb-4">
            <svg class="w-10 h-10 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m6.75 12H9.75m3 0v3m0-3V15m-3-3h6m-9 3H6.375a1.875 1.875 0 01-1.875-1.875V5.625A1.875 1.875 0 016.375 3.75h5.25"/>
            </svg>
          </div>
          <h4 class="text-lg font-semibold text-gray-700 dark:text-gray-300 mb-2">Chưa có dự án</h4>
          <p class="text-sm text-gray-500 dark:text-gray-400 max-w-sm">
            Hiện chưa có dự án nào sử dụng <strong>${skillName}</strong>. 
            Các dự án sẽ được cập nhật sớm!
          </p>
        </div>
      `;
    }
    
    // Hiện modal với animation
    modal.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal.querySelector('.modal-content').classList.add('modal-open');
      modal.querySelector('#skill-modal-overlay').classList.add('modal-overlay-open');
    });
    
    // Chặn scroll body
    document.body.style.overflow = 'hidden';
  }
  
  // Đóng modal
  function closeSkillModal() {
    const modal = document.getElementById('skill-modal');
    const content = modal.querySelector('.modal-content');
    const overlay = modal.querySelector('#skill-modal-overlay');
    
    content.classList.remove('modal-open');
    overlay.classList.remove('modal-overlay-open');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 250);
  }
  
  // Đóng modal khi nhấn Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSkillModal();
  });
</script>
