{# 
  Component Hero Section
  Phần đầu tiên người dùng nhìn thấy, bao gồm:
  - Ảnh đại diện (avatar)
  - Tên và chức danh
  - Tagline giới thiệu ngắn
  - Nút CTA (Call to Action)
  - Hiệu ứng gradient background
#}
<section id="hero" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
  
  {# === Background Gradient trang trí === #}
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-accent/10 dark:bg-accent/5 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-navy-400/10 dark:bg-navy-600/5 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-accent/5 to-transparent rounded-full"></div>
  </div>
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
      
      {# === Ảnh đại diện === #}
      <div class="fade-in relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-accent to-navy-500 rounded-full opacity-70 group-hover:opacity-100 blur transition-opacity duration-500"></div>
        <img 
          src="{{ site.avatar }}" 
          alt="Ảnh đại diện {{ site.name }}"
          class="relative w-48 h-48 md:w-56 md:h-56 rounded-full object-cover border-4 border-white dark:border-navy-900 shadow-2xl"
          loading="eager"
        >
        {# Badge trạng thái #}
        <div class="absolute bottom-2 right-2 w-6 h-6 bg-green-400 rounded-full border-4 border-white dark:border-navy-900 shadow-lg"></div>
      </div>
      
      {# === Nội dung chính === #}
      <div class="text-center md:text-left space-y-6">
        {# Chào hỏi nhỏ #}
        <p class="fade-in text-accent dark:text-accent-light font-mono text-sm tracking-wider uppercase">
          👋 Xin chào, tôi là
        </p>
        
        {# Tên #}
        <h1 class="fade-in text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white leading-tight">
          {{ site.name }}
        </h1>
        
        {# Chức danh với hiệu ứng gradient #}
        <p class="fade-in text-xl sm:text-2xl font-semibold bg-gradient-to-r from-accent to-navy-500 dark:from-accent-light dark:to-blue-300 bg-clip-text text-transparent">
          {{ site.role }}
        </p>
        
        {# Tagline #}
        <p class="fade-in text-lg text-gray-600 dark:text-gray-400 max-w-lg leading-relaxed">
          {{ site.tagline }}
        </p>
        
        {# Nút CTA #}
        <div class="fade-in flex flex-wrap gap-4 justify-center md:justify-start">
          <a href="{{ site.ctaLink }}" 
             class="inline-flex items-center gap-2 px-6 py-3 bg-accent hover:bg-accent-dark text-white font-semibold rounded-xl shadow-lg shadow-accent/25 hover:shadow-accent/40 transform hover:-translate-y-0.5 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-4-4m4 4l-4 4"/>
            </svg>
            {{ site.ctaText }}
          </a>
          <a href="{{ site.cvLink }}" 
             class="inline-flex items-center gap-2 px-6 py-3 border-2 border-gray-300 dark:border-navy-600 text-gray-700 dark:text-gray-300 font-semibold rounded-xl hover:border-accent hover:text-accent dark:hover:border-accent-light dark:hover:text-accent-light transform hover:-translate-y-0.5 transition-all duration-300">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Tải CV
          </a>
        </div>
        
        {# Thống kê nhanh #}
        <div class="fade-in flex gap-8 justify-center md:justify-start pt-4">
          <div class="text-center">
            <p class="text-2xl font-bold font-mono text-navy-700 dark:text-white">2+</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider">Dự án</p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold font-mono text-navy-700 dark:text-white">3.3</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider">GPA</p>
          </div>
          <div class="text-center">
            <p class="text-2xl font-bold font-mono text-navy-700 dark:text-white">MIS</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider">Chuyên ngành</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  {# === Mũi tên cuộn xuống === #}
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#about" class="text-gray-400 dark:text-gray-500 hover:text-accent transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </div>
</section>
