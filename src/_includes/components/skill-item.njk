{# 
  Component Skill Item (skill-item.njk)
  Hiển thị một kỹ năng dạng tag + progress bar
  Nhận data qua biến skill (truyền từ vòng lặp {% for %})
  Giống @component('skill-item', ['skill' => $skill]) trong Blade
#}
<div class="skill-item bg-white dark:bg-navy-800/50 rounded-xl p-5 border border-gray-100 dark:border-navy-700/50 hover:shadow-lg hover:border-accent/30 dark:hover:border-accent/30 transform hover:-translate-y-1 transition-all duration-300">
  {# Hàng trên: icon + tên + level #}
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-3">
      <span class="text-2xl">{{ skill.icon }}</span>
      <div>
        <h4 class="font-semibold text-gray-900 dark:text-white text-sm">{{ skill.name }}</h4>
        <p class="text-xs text-gray-500 dark:text-gray-400 font-mono">{{ skill.category }}</p>
      </div>
    </div>
    <span class="text-sm font-bold font-mono text-accent dark:text-accent-light">{{ skill.level }}%</span>
  </div>
  
  {# Progress bar #}
  <div class="w-full bg-gray-200 dark:bg-navy-700 rounded-full h-2 overflow-hidden">
    <div class="skill-progress h-full bg-gradient-to-r from-accent to-navy-500 rounded-full transition-all duration-1000 ease-out" 
         style="width: 0%;" 
         data-level="{{ skill.level }}">
    </div>
  </div>
  
  {# Mô tả ngắn #}
  <p class="mt-3 text-xs text-gray-500 dark:text-gray-400 leading-relaxed">{{ skill.description }}</p>
</div>
