{# 
  Component Contact Section
  Phần liên hệ bao gồm:
  - Thông tin liên hệ (email, social links)
  - Nút tải CV
#}
<section id="contact" class="py-20 bg-gray-50/50 dark:bg-navy-900/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {# === Tiêu đề Section === #}
    <div class="text-center mb-16 fade-in">
      <p class="text-accent dark:text-accent-light font-mono text-sm tracking-wider uppercase mb-2">Liên hệ</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        Hãy kết nối với tôi
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-accent to-navy-500 mx-auto mt-4 rounded-full"></div>
      <p class="text-gray-600 dark:text-gray-400 mt-4 max-w-lg mx-auto">
        Bạn có dự án cần phân tích dữ liệu? Đừng ngần ngại liên hệ nhé!
      </p>
    </div>
    
    <div class="grid sm:grid-cols-2 gap-6 fade-in">
      
      {# Email #}
      <a href="mailto:{{ site.email }}" 
         class="flex items-center justify-center sm:justify-start gap-4 p-6 bg-white dark:bg-navy-800/50 rounded-2xl border border-gray-100 dark:border-navy-700/50 hover:border-accent/30 hover:shadow-lg transition-all duration-300 group transform hover:-translate-y-1">
        <div class="w-14 h-14 bg-accent/10 dark:bg-accent/20 rounded-xl flex items-center justify-center text-accent group-hover:bg-accent group-hover:text-white transition-all duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-gray-900 dark:text-white">Email</p>
          <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">{{ site.email }}</p>
        </div>
      </a>
      
      {# LinkedIn #}
      <a href="{{ site.social.linkedin }}" target="_blank"
         class="flex items-center justify-center sm:justify-start gap-4 p-6 bg-white dark:bg-navy-800/50 rounded-2xl border border-gray-100 dark:border-navy-700/50 hover:border-accent/30 hover:shadow-lg transition-all duration-300 group transform hover:-translate-y-1">
        <div class="w-14 h-14 bg-blue-600/10 dark:bg-blue-600/20 rounded-xl flex items-center justify-center text-blue-600 dark:text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-gray-900 dark:text-white">LinkedIn</p>
          <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Kết nối công việc</p>
        </div>
      </a>
      
      {# GitHub #}
      <a href="{{ site.social.github }}" target="_blank"
         class="flex items-center justify-center sm:justify-start gap-4 p-6 bg-white dark:bg-navy-800/50 rounded-2xl border border-gray-100 dark:border-navy-700/50 hover:border-accent/30 hover:shadow-lg transition-all duration-300 group transform hover:-translate-y-1">
        <div class="w-14 h-14 bg-gray-900/10 dark:bg-white/10 rounded-xl flex items-center justify-center text-gray-900 dark:text-white group-hover:bg-gray-900 group-hover:text-white dark:group-hover:bg-white dark:group-hover:text-gray-900 transition-all duration-300">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-gray-900 dark:text-white">GitHub</p>
          <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">Source code dự án</p>
        </div>
      </a>
      
      {# Tải CV #}
      <a href="{{ site.cvLink }}" 
         class="flex items-center justify-center sm:justify-start gap-4 p-6 bg-accent/5 dark:bg-accent/10 rounded-2xl border border-accent/20 hover:bg-accent hover:text-white transition-all duration-300 group transform hover:-translate-y-1">
        <div class="w-14 h-14 bg-white dark:bg-navy-900 rounded-xl flex items-center justify-center text-accent transition-all duration-300">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <div>
          <p class="font-semibold text-gray-900 dark:text-white group-hover:text-white transition-colors">Tải CV</p>
          <p class="text-accent/80 dark:text-accent-light/80 group-hover:text-white/80 text-sm mt-1 transition-colors">Định dạng PDF</p>
        </div>
      </a>
      
    </div>
  </div>
</section>
