{# 
  Component About Me
  Phần giới thiệu bản thân, bao gồm:
  - Đoạn giới thiệu ngắn
  - Học vấn
  - Mục tiêu nghề nghiệp
  Dữ liệu đọc từ site.json (giống Controller trả data về View)
#}
<section id="about" class="py-20 bg-gray-50/50 dark:bg-navy-900/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {# === Tiêu đề Section === #}
    <div class="text-center mb-16 fade-in">
      <p class="text-accent dark:text-accent-light font-mono text-sm tracking-wider uppercase mb-2">Về tôi</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        Giới thiệu bản thân
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-accent to-navy-500 mx-auto mt-4 rounded-full"></div>
    </div>
    
    {# === Nội dung About === #}
    <div class="grid md:grid-cols-2 gap-12 items-start">
      
      {# Cột trái: Giới thiệu chung #}
      <div class="space-y-6 fade-in">
        <div class="bg-white dark:bg-navy-800/50 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-navy-700/50 hover:shadow-md transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">👤</span>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Tôi là ai?</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
            {{ site.about.intro }}
          </p>
        </div>
        
        <div class="bg-white dark:bg-navy-800/50 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-navy-700/50 hover:shadow-md transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">🎯</span>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Mục tiêu</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
            {{ site.about.goal }}
          </p>
        </div>
      </div>
      
      {# Cột phải: Học vấn + Info card #}
      <div class="space-y-6 fade-in">
        <div class="bg-white dark:bg-navy-800/50 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-navy-700/50 hover:shadow-md transition-shadow duration-300">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-2xl">🎓</span>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Học vấn</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
            {{ site.about.education }}
          </p>
        </div>
        
        {# Thông tin liên hệ nhanh #}
        <div class="bg-gradient-to-br from-accent/5 to-navy-500/5 dark:from-accent/10 dark:to-navy-600/10 rounded-2xl p-6 border border-accent/10 dark:border-accent/20">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">📌 Thông tin nhanh</h3>
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-accent dark:text-accent-light">📍</span>
              <span class="text-gray-600 dark:text-gray-400">{{ site.location }}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-accent dark:text-accent-light">📧</span>
              <a href="mailto:{{ site.email }}" class="text-gray-600 dark:text-gray-400 hover:text-accent transition-colors">{{ site.email }}</a>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-accent dark:text-accent-light">💼</span>
              <span class="text-gray-600 dark:text-gray-400">{{ site.role }}</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-accent dark:text-accent-light">🌐</span>
              <div class="flex gap-3">
                <a href="{{ site.social.github }}" target="_blank" class="text-gray-500 hover:text-accent transition-colors text-sm font-mono">GitHub</a>
                <a href="{{ site.social.linkedin }}" target="_blank" class="text-gray-500 hover:text-accent transition-colors text-sm font-mono">LinkedIn</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
