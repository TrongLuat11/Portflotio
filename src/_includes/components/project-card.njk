{# 
  Component Project Card (project-card.njk)
  Hiển thị 1 dự án dạng card chi tiết, bao gồm:
  - Ảnh minh họa
  - Tên, mô tả tóm tắt
  - Chi tiết: bài toán, dữ liệu, phương pháp, kết quả
  - Tag công nghệ
  - Link GitHub + Demo
  Nhận data qua biến project (truyền từ vòng lặp)
  Giống @component('project-card', ['project' => $project]) trong Blade
#}
<article class="project-card group bg-white dark:bg-navy-800/50 rounded-2xl overflow-hidden border border-gray-100 dark:border-navy-700/50 hover:shadow-xl hover:border-accent/20 dark:hover:border-accent/30 transition-all duration-500">
  
  {# === Ảnh dự án === #}
  <div class="relative overflow-hidden aspect-video">
    <img 
      src="{{ project.image }}" 
      alt="{{ project.title }}"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      loading="lazy"
    >
    {# Overlay gradient khi hover #}
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    
    {# Nút xem nhanh khi hover #}
    <div class="absolute bottom-4 left-4 right-4 flex gap-2 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
      <a href="{{ project.github }}" target="_blank" 
         class="flex-1 text-center px-3 py-2 bg-white/90 backdrop-blur-sm text-gray-900 text-sm font-medium rounded-lg hover:bg-white transition-colors">
        ⚡ GitHub
      </a>
      <a href="{{ project.demo }}" target="_blank"
         class="flex-1 text-center px-3 py-2 bg-accent/90 backdrop-blur-sm text-white text-sm font-medium rounded-lg hover:bg-accent transition-colors">
        🔗 Demo
      </a>
    </div>
  </div>
  
  {# === Nội dung card === #}
  <div class="p-6 space-y-4">
    {# Tên dự án #}
    <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-accent dark:group-hover:text-accent-light transition-colors">
      {{ project.title }}
    </h3>
    
    {# Tóm tắt #}
    <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
      {{ project.summary }}
    </p>
    
    {# Chi tiết dự án — accordion style #}
    <div class="space-y-3 text-sm">
      <div class="bg-gray-50 dark:bg-navy-900/50 rounded-lg p-3">
        <p class="font-semibold text-navy-700 dark:text-navy-200 mb-1">🎯 Bài toán</p>
        <p class="text-gray-600 dark:text-gray-400">{{ project.problem }}</p>
      </div>
      <div class="bg-gray-50 dark:bg-navy-900/50 rounded-lg p-3">
        <p class="font-semibold text-navy-700 dark:text-navy-200 mb-1">📁 Dữ liệu</p>
        <p class="text-gray-600 dark:text-gray-400">{{ project.data }}</p>
      </div>
      <div class="bg-gray-50 dark:bg-navy-900/50 rounded-lg p-3">
        <p class="font-semibold text-navy-700 dark:text-navy-200 mb-1">🔬 Phương pháp</p>
        <p class="text-gray-600 dark:text-gray-400">{{ project.method }}</p>
      </div>
      <div class="bg-accent/5 dark:bg-accent/10 rounded-lg p-3 border border-accent/10">
        <p class="font-semibold text-accent dark:text-accent-light mb-1">✅ Kết quả</p>
        <p class="text-gray-700 dark:text-gray-300">{{ project.result }}</p>
      </div>
    </div>
    
    {# Tag công nghệ #}
    <div class="flex flex-wrap gap-2 pt-2">
      {% for tag in project.tags %}
        <span class="px-3 py-1 text-xs font-mono font-medium bg-navy-50 dark:bg-navy-700/50 text-navy-600 dark:text-navy-200 rounded-full border border-navy-100 dark:border-navy-600/50">
          {{ tag }}
        </span>
      {% endfor %}
    </div>
  </div>
</article>
